# Copy this file to `.env.local` (never commit real values) and fill in your own.
# For local development, `npm run setup:env` generates a complete .env.local
# (fresh AUTH_SECRET plus one random-password account per role).

# --- Authentication (required) --------------------------------------------------
# Secret used to sign the httpOnly session cookie. At least 32 random characters:
#   openssl rand -base64 48
AUTH_SECRET=

# JSON array of accounts allowed to sign in. There are no built-in accounts.
# role is one of: facility | district | state | admin
# Create each passwordHash with:  npm run hash-password -- "a strong password"
# Keep the value on one line and wrap it in single quotes:
#   AUTH_USERS='[{"email":"state.admin@example.org","role":"state","passwordHash":"scrypt:<salt>:<hash>"}]'
AUTH_USERS=

# --- Google AI (Gemini) (AI-powered trend analysis) ---------------------------
# API key from https://aistudio.google.com/apikey . Optional: without it the
# "Generate Full Dashboard Analysis" feature returns a rule-based summary.
# Server-side only: do NOT prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# auto (default) | live | demo
AI_MODE=auto
# Per-user AI requests per minute
AI_RATE_LIMIT_PER_MIN=12

# --- Site ----------------------------------------------------------------------
# Public, canonical URL of the deployed site (no trailing slash). Used for
# metadataBase, Open Graph URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:9002
